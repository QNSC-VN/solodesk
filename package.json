{
  "name": "solodesk",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @solodesk/backend-api db:migrate",
    "db:migrate:test": "pnpm --filter @solodesk/backend-api db:migrate:test"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.4.3",
      "esbuild": "^0.25.0"
    },
    "onlyBuiltDependencies": [
      "@swc/core"
    ]
  }
}
