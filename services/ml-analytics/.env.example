# Same 5-role-per-database-connection convention as the other 3 services —
# see CLAUDE.md. The docker-compose superuser must never be the app's
# runtime connection, not even locally.
HOST=0.0.0.0
PORT=3003

# The app's own runtime connection — solodesk_ml, SELECT-only on
# sales.orders (see db/migrations/0001_provision_ml_role.sql).
DATABASE_URL=postgres://solodesk_ml:REPLACE_WITH_ROLE_PASSWORD@localhost:5432/solodesk

# Migration-only — never the app's runtime connection. Same value as the
# other 3 services' DATABASE_ADMIN_URL (docker-compose's solodesk_superuser).
DATABASE_ADMIN_URL=postgres://solodesk_superuser:REPLACE_WITH_SUPERUSER_PASSWORD@localhost:5432/solodesk
SOLODESK_ML_ROLE_PASSWORD=REPLACE_WITH_ROLE_PASSWORD

# Service-to-service auth — agent-orchestrator calls this service's
# /v1/forecast endpoint from inside a Temporal Activity (docs Section 5.5's
# rule: never called synchronously from an HTTP handler outside a
# Workflow/Activity). Same shared secret as backend-api's/connector-hub's
# INTERNAL_SERVICE_TOKEN — MUST match exactly across all services that use
# it. This is the 2nd consumer of this mechanism (the 1st: connector-hub ->
# backend-api) — same shape generalizes fine, no redesign needed.
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_REAL_SHARED_SECRET
