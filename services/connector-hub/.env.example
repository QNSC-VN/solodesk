# Runtime connection — MUST be the solodesk_connector role, never the migration admin role.
# Same Postgres DATABASE as backend-api (Section 3: one modular-monolith
# database, separate schemas per bounded context, separate compute per
# deployable) — just a different role, GRANTed only on vault/sync schemas.
DATABASE_URL=postgres://solodesk_connector:connector_only_password@localhost:5432/solodesk
DATABASE_POOL_SIZE=10

# Migration-only — must NOT be reachable from app runtime env (see src/db/client.ts).
DATABASE_ADMIN_URL=postgres://solodesk_superuser:dev_only_password@localhost:5432/solodesk
SOLODESK_CONNECTOR_ROLE_PASSWORD=connector_only_password

NODE_ENV=development
PORT=3001
SWAGGER_ENABLED=true

# Auth — SAME issuer/keypair as backend-api's .env (one identity provider
# across services; a token minted against either service's mint-dev-token.ts
# verifies against both, since they share JWT_ISSUER/JWT_AUDIENCE/JWT_PUBLIC_KEY).
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=solodesk:
JWT_ISSUER=solodesk
JWT_AUDIENCE=solodesk-api
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# DEV/TEST ONLY — copy the exact same value from backend-api/.env.
DEV_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Vault master key — 32 raw bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this makes every previously-vaulted credential undecryptable —
# there is no key-rotation/re-encryption tooling yet (YAGNI until a real
# rotation need arises).
VAULT_MASTER_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# Per-provider API base URLs — sandbox vs prod, never hardcoded in adapters.
SEPAY_API_BASE_URL=https://my.sepay.vn/userapi
GHN_API_BASE_URL=https://online-gateway.ghn.vn/shiip/public-api
SHOPEE_API_BASE_URL=https://partner.shopeemobile.com
# Real per-tenant provider credentials (Shopee partner key, GHN token, SePay
# API token/webhook secret, ...) are NEVER env vars — they're entered via
# POST /v1/vault/:provider/credentials, encrypted at rest. See CLAUDE.md.
