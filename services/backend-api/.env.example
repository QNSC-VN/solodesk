# Runtime connection — MUST be the solodesk_app role, never the migration admin role.
DATABASE_URL=postgres://solodesk_app:app_only_password@localhost:5432/solodesk
DATABASE_POOL_SIZE=10

# Migration-only — must NOT be reachable from app runtime env (see src/db/client.ts).
DATABASE_ADMIN_URL=postgres://solodesk_superuser:dev_only_password@localhost:5432/solodesk
SOLODESK_APP_ROLE_PASSWORD=app_only_password

NODE_ENV=development
PORT=3000
SWAGGER_ENABLED=true

# Auth — token verification only (src/platform/auth/auth.module.ts).
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=solodesk:
JWT_ISSUER=solodesk
JWT_AUDIENCE=solodesk-api
# ES256 PEM, one line with \n escapes (or use a multi-line .env parser that
# supports it) — generate a dev pair with:
#   node -e "const{generateKeyPairSync}=require('crypto');const{publicKey,privateKey}=generateKeyPairSync('ec',{namedCurve:'P-256',publicKeyEncoding:{type:'spki',format:'pem'},privateKeyEncoding:{type:'pkcs8',format:'pem'}});console.log(publicKey);console.log(privateKey);"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# DEV/TEST ONLY — never set in a real deployed environment (env.schema.ts
# refuses to boot if this is set alongside NODE_ENV=production). Used only by
# scripts/mint-dev-token.ts until a real login/SSO flow exists.
DEV_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Real login (src/modules/auth) — signs real signup/login/refresh access
# tokens. Same keypair as JWT_PUBLIC_KEY above (this is its private half) —
# can reuse the same generated pair as DEV_JWT_PRIVATE_KEY locally, or a
# separate one; either way JWT_PUBLIC_KEY must be the matching public half.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Google Sign-In — Google Cloud Console OAuth 2.0 client id (the expected
# id_token audience). "Let key, I will input later."
GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID

# Transactional email (signup verification, password reset) — Resend.
# "Let key, I will input later": unset locally, EmailService logs the email
# instead of sending it (see src/platform/email.service.ts).
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@solodesk.vn

# Service-to-service — connector-hub forwards a verified SePay payment event
# to POST /internal/payments/by-invoice-number, authenticated by this shared
# secret (X-Internal-Service-Token header), NOT a per-user JWT. Same value
# MUST be set in connector-hub/.env. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_32_BYTE_RANDOM_SECRET

# Background jobs (BullMQ on the same Valkey as REDIS_URL) — invoice PDF
# generation. Local filesystem for this first cut, see src/worker-pdf.ts.
GENERATED_FILES_DIR=./generated
