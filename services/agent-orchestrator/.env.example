# Runtime connection — MUST be the solodesk_agent role (SELECT-only), never
# the migration admin role. Same Postgres DATABASE as backend-api/connector-hub.
DATABASE_URL=postgres://solodesk_agent:agent_only_password@localhost:5432/solodesk
DATABASE_POOL_SIZE=10

# Migration-only — must NOT be reachable from app runtime env (see src/db/client.ts).
# IMPORTANT: run this service's db:migrate AFTER backend-api's — 0001 GRANTs
# on tables backend-api's migrations create (identity.tenants, sales.orders).
DATABASE_ADMIN_URL=postgres://solodesk_superuser:dev_only_password@localhost:5432/solodesk
SOLODESK_AGENT_ROLE_PASSWORD=agent_only_password

NODE_ENV=development
PORT=3002
SWAGGER_ENABLED=true

# Auth — SAME issuer/keypair as backend-api/connector-hub's .env.
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=solodesk:
JWT_ISSUER=solodesk
JWT_AUDIENCE=solodesk-api
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# DEV/TEST ONLY — copy the exact same value from backend-api/.env.
DEV_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Temporal — local dev: install the CLI (`brew install temporal`) and run
# `temporal server start-dev` in a separate terminal (embedded sqlite, no
# external DB, Web UI at http://localhost:8233). Self-hosted-vs-Cloud for a
# real deployment is an explicitly unresolved docs Section 13 business
# decision — not decided here.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agent-tasks

# LLM — a REAL Anthropic API key, entered by the user (same "let key, I'll
# input later" pattern as connector-hub's vault credentials, except this one
# is a plain env var, not per-tenant vaulted — there is exactly one LLM
# credential for the whole service in this first cut, not per-tenant yet).
# No LiteLLM gateway / multi-provider fallback / per-tenant budget yet —
# see CLAUDE.md for the explicit scope decision.
ANTHROPIC_API_KEY=REPLACE_WITH_REAL_ANTHROPIC_API_KEY
# Verify against Anthropic's current model list before relying on this default.
ANTHROPIC_MODEL=claude-sonnet-4-5
