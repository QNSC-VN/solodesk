{
  "name": "@solodesk/agent-orchestrator",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "worker": "tsx watch src/worker.ts",
    "worker:start": "node dist/worker.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:test": "NODE_ENV=test tsx src/db/migrate.ts",
    "mint-dev-token": "tsx scripts/mint-dev-token.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@fastify/static": "^10.1.2",
    "@nestjs/swagger": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.4.0",
    "@nestjs/passport": "^11.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "uuidv7": "^1.0.0",
    "@qnsc-vn/identity": "^6.0.0",
    "@qnsc-vn/platform-http": "^3.1.0",
    "@qnsc-vn/observability": "^0.1.4",
    "@qnsc-vn/platform-cache": "^2.1.0",
    "@temporalio/client": "^1.22.0",
    "@temporalio/worker": "^1.22.0",
    "@temporalio/workflow": "^1.22.0",
    "@temporalio/activity": "^1.22.0",
    "@temporalio/common": "^1.22.0",
    "@anthropic-ai/sdk": "^0.117.1",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@temporalio/testing": "^1.22.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "fastify": "^5.0.0",
    "jsonwebtoken": "^9.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "vitest": "^3.2.6"
  }
}
