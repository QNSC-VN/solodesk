# "Let key, I will input later" — same convention as every other app in
# this repo. Android emulators can't reach the host's `localhost` — use
# 10.0.2.2 there; iOS simulator and a real device on the same LAN as your
# dev machine use its real LAN IP instead of localhost.
BACKEND_API_BASE_URL=http://localhost:3000/v1
AGENT_ORCHESTRATOR_BASE_URL=http://localhost:3002/v1
