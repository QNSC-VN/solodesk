# backend-api — this app is its own thin BFF: Server Actions/Server
# Components call these endpoints server-side (never from the browser —
# backend-api has no CORS configured, see CLAUDE.md's "web-accounting"
# section), with the access token read from an httpOnly cookie this app
# sets itself after a real login call.
BACKEND_API_BASE_URL=http://localhost:3000/v1

# Google Sign-In button (client-side Google Identity Services SDK) — the
# OAuth client id is not secret (only a client secret would be), same
# value as backend-api's own GOOGLE_OAUTH_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID

# Test-fixture seeding only (real Postgres, no mocks) — same convention as
# web-buyer-portal/test/trace.spec.ts. Never something the running app
# itself connects with.
DATABASE_ADMIN_URL=postgres://solodesk_superuser:dev_only_password@localhost:5432/solodesk
